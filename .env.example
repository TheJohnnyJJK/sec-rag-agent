# Copy to .env and fill in. .env is gitignored — never commit it.

# Anthropic API key — used for generation, the LLM judge, and the agent loop.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Contact string SEC EDGAR requires on every request. Format: "Name email@example.com".
# Falls back to a placeholder if unset, which EDGAR may rate-limit.
SEC_IDENTITY=
